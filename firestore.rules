rules_version = '2';
// Règles Firestore équivalentes. L'application utilise la Realtime Database ;
// ces règles protègent Firestore si vous l'activez et refusent tout le reste.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email in ['anton@talcomap.app', 'talco@talcomap.app']; }
    function notBanned() { return signedIn() && !exists(/databases/$(database)/documents/banned/$(request.auth.uid)); }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if isAdmin() || (request.auth.uid == uid && notBanned()
        && request.resource.data.pseudo is string
        && request.resource.data.pseudo.matches('^[a-zA-Z0-9_.-]{3,20}$'));
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }
    match /saved/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin() || (signedIn() && request.auth.uid == uid && notBanned());
    }
    match /reports/{id} {
      allow read: if true;
      allow create: if signedIn() && notBanned()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['police','controleur','accident','danger','radar','bouchon','travaux']
        && request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lon is number && request.resource.data.lon >= -180 && request.resource.data.lon <= 180
        && request.resource.data.t == request.time;
      allow update: if signedIn() && notBanned()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']);
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }
    match /banned/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
