{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null && (auth.token.email === 'anton@talcomap.app' || auth.token.email === 'talco@talcomap.app')",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && ((auth.uid === $uid && !root.child('banned').child(auth.uid).exists()) || (auth.token.email === 'anton@talcomap.app' || auth.token.email === 'talco@talcomap.app'))",
        "pseudo": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-zA-Z0-9_.-]{3,20}$/)"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "deleted": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "saved": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (auth.token.email === 'anton@talcomap.app' || auth.token.email === 'talco@talcomap.app'))",
        ".write": "auth != null && ((auth.uid === $uid && !root.child('banned').child(auth.uid).exists()) || (auth.token.email === 'anton@talcomap.app' || auth.token.email === 'talco@talcomap.app'))"
      }
    },
    "reports": {
      ".read": true,
      ".indexOn": [
        "t",
        "uid"
      ],
      "$id": {
        ".write": "auth != null && ((!root.child('banned').child(auth.uid).exists() && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('uid').val() === auth.uid))) || (data.exists() && !newData.exists() && (auth.token.email === 'anton@talcomap.app' || auth.token.email === 'talco@talcomap.app')))",
        ".validate": "newData.hasChildren(['uid','pseudo','type','lat','lon','t'])",
        "uid": {
          ".validate": "newData.isString()"
        },
        "pseudo": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "type": {
          ".validate": "newData.isString() && newData.val().matches(/^(police|controleur|accident|danger|radar|bouchon|travaux)$/)"
        },
        "lat": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
        },
        "lon": {
          ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
        },
        "t": {
          ".validate": "newData.isNumber() && (data.exists() || (newData.val() <= now + 60000 && newData.val() >= now - 60000))"
        },
        "v": {
          "$vuid": {
            ".write": "auth != null && auth.uid === $vuid && !root.child('banned').child(auth.uid).exists()",
            ".validate": "newData.val() === 1 || newData.val() === -1"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "banned": {
      ".read": "auth != null && (auth.token.email === 'anton@talcomap.app' || auth.token.email === 'talco@talcomap.app')",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.token.email === 'anton@talcomap.app' || auth.token.email === 'talco@talcomap.app')"
      }
    },
    "config": {
      ".read": true,
      "policeAlerts": {
        ".write": "auth != null && (auth.token.email === 'anton@talcomap.app' || auth.token.email === 'talco@talcomap.app')",
        ".validate": "newData.isBoolean()"
      }
    }
  }
}